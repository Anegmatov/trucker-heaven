# Parking API environment. Every variable this module reads is prefixed PARKING_
# (see env.js) so it can share a process with the other Trucker Heaven modules.
# PORT is the only unprefixed setting and is used by server.js alone.
NODE_ENV=development
PORT=3001
PARKING_DATABASE_URL=postgres://postgres:postgres@localhost:5432/parkingops
PARKING_DATABASE_SSL=
PARKING_CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5181,http://127.0.0.1:5180,http://127.0.0.1:5181
PARKING_CUSTOMER_APP_URL=http://localhost:5180
PARKING_ADMIN_APP_URL=http://localhost:5181
# Render production values:
# PARKING_CORS_ALLOWED_ORIGINS=https://trucker-heaven-parking-a437.onrender.com,https://trucker-heaven-parking-admin-krfn.onrender.com
# PARKING_CUSTOMER_APP_URL=https://trucker-heaven-parking-a437.onrender.com
# PARKING_ADMIN_APP_URL=https://trucker-heaven-parking-admin-krfn.onrender.com
# API base: https://trucker-heaven-parking-api-vkf9.onrender.com/api

# My Parking / Upload Documents: short-lived email+phone lookup grant (cookie).
# No OTP, email or SMS provider is needed. For separate Render hostnames use
# PARKING_CUSTOMER_COOKIE_SECURE=true and PARKING_CUSTOMER_COOKIE_SAME_SITE=none.
# Use a dedicated random pepper in production; never reuse a human password.
PARKING_CUSTOMER_COOKIE_SECURE=false
PARKING_CUSTOMER_COOKIE_SAME_SITE=lax
PARKING_CUSTOMER_LOOKUP_COOKIE_NAME=parking_customer_lookup
PARKING_CUSTOMER_LOOKUP_TTL_SECONDS=900
PARKING_CUSTOMER_LOOKUP_RATE_LIMIT_MAX=8
PARKING_CUSTOMER_LOOKUP_RATE_LIMIT_WINDOW_SECONDS=900
# PARKING_CUSTOMER_LOOKUP_PEPPER=at-least-32-random-characters (falls back to PARKING_SESSION_TOKEN_PEPPER)

# Production notification transports. Leave providers blank to fail closed.
# Email supports Resend; SMS supports Twilio. Tests inject an in-memory adapter.
# PARKING_NOTIFICATION_EMAIL_PROVIDER=RESEND
# PARKING_NOTIFICATION_EMAIL_FROM=Trucker Heaven Parking <parking@example.com>
# PARKING_RESEND_API_KEY=
# PARKING_NOTIFICATION_SMS_PROVIDER=TWILIO
# PARKING_TWILIO_ACCOUNT_SID=
# PARKING_TWILIO_AUTH_TOKEN=
# PARKING_TWILIO_FROM_NUMBER=+16015551234
# For separate Render hostnames: COOKIE_SECURE=true and COOKIE_SAME_SITE=none
# Same-site custom subdomains may retain COOKIE_SAME_SITE=lax.
PARKING_COOKIE_SECURE=false
PARKING_COOKIE_SAME_SITE=lax
PARKING_SESSION_TOKEN_PEPPER=replace-with-a-long-random-production-secret
PARKING_SESSION_TTL_SECONDS=28800
PARKING_ADMIN_LOGIN_RATE_LIMIT_MAX=10
PARKING_ADMIN_LOCKOUT_THRESHOLD=5
PARKING_ADMIN_LOCKOUT_SECONDS=900
PARKING_JSON_BODY_LIMIT=100kb
PARKING_GENERAL_RATE_LIMIT_MAX=300
PARKING_PUBLIC_AVAILABILITY_RATE_LIMIT_MAX=60
PARKING_PUBLIC_QUOTE_RATE_LIMIT_MAX=30
PARKING_PUBLIC_BOOKING_RATE_LIMIT_MAX=12
PARKING_PUBLIC_LOOKUP_RATE_LIMIT_MAX=12
PARKING_PUBLIC_BOOKING_MINIMUM_MONTHLY_DAYS=28
PARKING_PUBLIC_BOOKING_MINIMUM_WEEKLY_DAYS=7
PARKING_PUBLIC_BOOKING_MAXIMUM_WEEKLY_DAYS=27
PARKING_PUBLIC_QUOTE_TTL_SECONDS=600
PARKING_PENDING_BOOKING_EXPIRY_MINUTES=30

# Stripe Checkout and webhook verification. Keep these values backend-only.
PARKING_STRIPE_SECRET_KEY=
PARKING_STRIPE_WEBHOOK_SECRET=
# Required for customer billing management. The referenced Stripe Customer
# Portal configuration must have subscription cancellation disabled.
PARKING_STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
PARKING_STRIPE_API_VERSION=2026-07-29.dahlia
PARKING_STRIPE_CURRENCY=usd
PARKING_STRIPE_CHECKOUT_TTL_SECONDS=1800
PARKING_STRIPE_WEBHOOK_GRACE_SECONDS=300
PARKING_MONTHLY_PAYMENT_GRACE_DAYS=7

# Private S3 or S3-compatible customer-document storage. Credentials use the
# standard AWS SDK environment/identity chain and are never sent to browsers.
PARKING_DOCUMENT_STORAGE_PROVIDER=S3
PARKING_DOCUMENT_STORAGE_BUCKET=
PARKING_DOCUMENT_STORAGE_REGION=us-east-1
PARKING_DOCUMENT_STORAGE_ENDPOINT=
PARKING_DOCUMENT_STORAGE_FORCE_PATH_STYLE=false
# Or keep documents on this server's disk instead of S3 (needs a persistent disk):
# PARKING_DOCUMENT_STORAGE_PROVIDER=LOCAL
# PARKING_DOCUMENT_STORAGE_DIR=/var/data/private-documents
# PARKING_DOCUMENT_STORAGE_PUBLIC_URL=https://parking-api.example.com   (when the site doesn't proxy /api)
# PARKING_DOCUMENT_STORAGE_SECRET=                                       (defaults to SESSION_TOKEN_PEPPER)
PARKING_DOCUMENT_UPLOAD_TTL_SECONDS=600
PARKING_DOCUMENT_READ_TTL_SECONDS=300
PARKING_DOCUMENT_MAX_BYTES=15728640
# Disabled by default. Enable only for a controlled QA window; never place a
# demo authorization token in configuration or source control.
PARKING_DEMO_PAYMENT_BYPASS_ENABLED=false
PARKING_DEMO_PAYMENT_BYPASS_TTL_SECONDS=300
