NODE_ENV=development
PORT=3011
DATABASE_URL=postgresql://foodops:foodops@127.0.0.1:5432/foodops_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10
PUBLIC_ORIGINS=http://localhost:5190
ADMIN_ORIGINS=http://localhost:5191
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
SESSION_TTL_HOURS=12
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_FAILURES=5
TRUST_PROXY=false
# Optional: defaults to backend/uploads when unset. Set this to persistent storage in deployment.
# FOODOPS_UPLOAD_ROOT=/var/lib/foodops/uploads
LOG_LEVEL=info
# Optional official Google Places API (New) integration. Configure both or neither.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
SEED_OWNER_EMAIL=owner@truckerheaven.test
SEED_OWNER_PASSWORD=ChangeMe-FoodOps-2026!
SEED_STAFF_EMAIL=staff@truckerheaven.test
SEED_STAFF_PASSWORD=ChangeMe-Staff-2026!
