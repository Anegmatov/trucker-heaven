{
  "name": "foodops-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Trucker Heaven FoodOps API, ordering, and administration service",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrations/run.js",
    "seed": "node scripts/seedDevelopment.js",
    "admin:create": "node scripts/createAdmin.js",
    "check": "node scripts/checkSyntax.js",
    "frontend:check": "node scripts/verifyFrontends.js",
    "test:unit": "node --test --test-concurrency=1 test/policies.test.js test/frontend-verifiers.test.js",
    "test:integration": "node --test --test-concurrency=1 test/postgres.integration.test.js test/kitchen-device.integration.test.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "verify": "npm run check && npm run frontend:check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
