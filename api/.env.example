# Shared API. Each module reads only its own prefix; nothing is shared between them.
PORT=3000
NODE_ENV=development
# Which modules to boot (default: all three)
API_MODULES=parking,rentals,food
# hostname=module pairs. Defaults to parking.localhost / rentals.localhost / food.localhost for local dev.
# Production example:
# API_HOSTS=parking-api.truckerheaven.com=parking,rentals-api.truckerheaven.com=rentals,food-api.truckerheaven.com=food

# --- parking (see parking/backend/.env.example for the full list) ---
# Leave the module database URLs unset to share one instance: the API uses API_DATABASE_URL (or the
# food module's DATABASE_URL) and creates a database named after each module on it.
# PARKING_DATABASE_URL=postgres://postgres@127.0.0.1:5432/parking
PARKING_CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5181
PARKING_DOCUMENT_STORAGE_PROVIDER=LOCAL
# First-run setup on a fresh parking database (location, OWNER staff login, prices, the real lot map,
# Amazon's monthly occupancy). Safe to leave on: each step runs once and is recorded in the database.
# PARKING_BOOTSTRAP=true
# PARKING_OWNER_USERNAME=owner
# PARKING_OWNER_PASSWORD=change-me-right-after-first-sign-in

# --- rentals (see rentals/backend/.env.example) ---
# RENTALS_DATABASE_URL=postgres://postgres@127.0.0.1:5432/rentals

# --- food: its own variable names work as-is (DATABASE_URL, PUBLIC_ORIGINS, ...); FOOD_-prefixed copies override them ---
DATABASE_URL=postgres://postgres@127.0.0.1:5432/food
# FOOD_PUBLIC_ORIGINS=https://food.truckerheaven.com
# FOOD_ADMIN_ORIGINS=https://food-admin.truckerheaven.com
# FOOD_FOODOPS_UPLOAD_ROOT=/var/data/food-uploads
