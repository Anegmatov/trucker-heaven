# Rentals backend settings. Every variable is prefixed RENTALS_ because this backend is one module of a
# shared Express process (see MERGE-NOTES.md). PORT and NODE_ENV are the only unprefixed names.
# Backend
PORT=3000
NODE_ENV=development
# Set to 1 behind a single trusted reverse proxy such as Render.
NoneRENTALS_TRUST_PROXY=0

# PostgreSQL. RENTALS_DATABASE_URL takes precedence when supplied.
# RENTALS_DATABASE_URL=postgresql://driveops:your_password_here@localhost:5432/driveops
NoneRENTALS_PGHOST=localhost
NoneRENTALS_PGPORT=5432
NoneRENTALS_PGDATABASE=driveops
NoneRENTALS_PGUSER=driveops
NoneRENTALS_PGPASSWORD=your_password_here

# Set DATABASE_SSL=true for a hosted PostgreSQL provider that requires TLS.
# Keep rejection enabled unless the provider explicitly requires otherwise.
NoneRENTALS_PGSSLMODE=
NoneRENTALS_DATABASE_SSL=false
NoneRENTALS_DATABASE_SSL_REJECT_UNAUTHORIZED=true
NoneRENTALS_PGPOOL_MAX=10

# PostgreSQL schema assumption: migrations and runtime queries use the public schema.
# Migrations are idempotent and run from init() at startup (and from `npm run migrate`).

# Comma-separated browser origins. Required and non-empty in production.
# RENTALS_CORS_ALLOWED_ORIGINS=https://rentals.truckerheaven.com,https://rentals-admin.truckerheaven.com
NoneRENTALS_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175

# JSON API request-body limit. Use b, kb, or mb units.
NoneRENTALS_JSON_BODY_LIMIT=1mb

# Public vehicle image storage. Images are served only through /uploads/vehicles.
NoneRENTALS_VEHICLE_UPLOAD_DIR=./uploads/vehicles
# Private local development storage for rental documents. This directory is never
# mounted as static content and must be outside frontend directories.
NoneRENTALS_RENTAL_UPLOAD_DIR=./uploads/rentals-private
NoneRENTALS_RENTAL_DOCUMENT_MAX_BYTES=6291456

# Per-client rate limits. Window values are milliseconds.
NoneRENTALS_RATE_LIMIT_WINDOW_MS=900000
NoneRENTALS_RATE_LIMIT_MAX=300
NoneRENTALS_RESERVATION_RATE_LIMIT_WINDOW_MS=3600000
NoneRENTALS_RESERVATION_RATE_LIMIT_MAX=10
# Maximum elapsed public-request duration in 24-hour days.
NoneRENTALS_MAX_RENTAL_DAYS=30
# First-launch rental policy: the API never contacts a payment provider. Payment
# and any required deposit are collected manually at pickup.
# PAY_AT_LOCATION is accepted as a deployment-friendly alias and is normalized
# to the stable API token PAY_AT_PICKUP.
NoneRENTALS_RENTAL_PAYMENT_MODE=PAY_AT_PICKUP
NoneRENTALS_ADMIN_RATE_LIMIT_WINDOW_MS=900000
NoneRENTALS_ADMIN_RATE_LIMIT_MAX=120

# Retired class-project routes (/api/auth, /api/cars, /api/rentals, /api/payments).
# May be enabled only outside production for temporary development compatibility.
NoneRENTALS_ENABLE_LEGACY_ROUTES=false

# Secure admin sessions. Production requires a unique non-empty SESSION_TOKEN_PEPPER.
NoneRENTALS_SESSION_COOKIE_NAME=driveops_admin_session
NoneRENTALS_SESSION_TTL_SECONDS=28800
NoneRENTALS_SESSION_TOKEN_PEPPER=replace-with-a-long-random-production-value
NoneRENTALS_COOKIE_SECURE=false
NoneRENTALS_COOKIE_SAME_SITE=lax
NoneRENTALS_CSRF_HEADER_NAME=x-csrf-token
NoneRENTALS_ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
NoneRENTALS_ADMIN_LOGIN_RATE_LIMIT_MAX=10
NoneRENTALS_ADMIN_LOCKOUT_THRESHOLD=5
NoneRENTALS_ADMIN_LOCKOUT_SECONDS=900

# Optional public URL for uploaded image links. Example: https://api.yourdomain.com
NoneRENTALS_PUBLIC_BASE_URL=http://localhost:3000
# Customer site address. Used to text customers a link to their reservation page.
NoneRENTALS_CUSTOMER_SITE_URL=http://localhost:5174
NoneRENTALS_RENTAL_OFFICE_NAME=Trucker Heaven Rentals
NoneRENTALS_RENTAL_OFFICE_ADDRESS=8037 Eastgate Blvd, Mt. Juliet, TN 37122
NoneRENTALS_RENTAL_OFFICE_PHONE=+16154705075
NoneRENTALS_SMS_ENABLED=false
# Maximum time an API request waits for an SMS provider response.
NoneRENTALS_SMS_TIMEOUT_MS=5000
NoneRENTALS_TWILIO_ACCOUNT_SID=
NoneRENTALS_TWILIO_AUTH_TOKEN=
NoneRENTALS_TWILIO_MESSAGING_SERVICE_SID=
NoneRENTALS_TWILIO_FROM_NUMBER=

# Production deployment shape (replace every placeholder; do not copy secrets
# into source control):
# NODE_ENV=production
# PORT=<platform-provided>
# RENTALS_DATABASE_URL=<driveops production database URL>
# RENTALS_DATABASE_SSL=<appropriate managed-database value>
# RENTALS_DATABASE_SSL_REJECT_UNAUTHORIZED=<platform-appropriate value>
# RENTALS_TRUST_PROXY=1
# RENTALS_CORS_ALLOWED_ORIGINS=https://rentals.truckerheaven.com,https://rentals-admin.truckerheaven.com
# RENTALS_SESSION_COOKIE_NAME=driveops_admin_session
# RENTALS_SESSION_TOKEN_PEPPER=<long random production secret>
# RENTALS_COOKIE_SECURE=true
# RENTALS_COOKIE_SAME_SITE=lax
# RENTALS_SESSION_TTL_SECONDS=28800
# RENTALS_PUBLIC_BASE_URL=https://rentals-api.truckerheaven.com
# RENTALS_VEHICLE_UPLOAD_DIR=/var/data/driveops/vehicles
# RENTALS_RENTAL_UPLOAD_DIR=/var/data/driveops/rentals-private
# RENTALS_RENTAL_PAYMENT_MODE=PAY_AT_LOCATION
# RENTALS_CUSTOMER_SITE_URL=https://rentals.truckerheaven.com
# RENTALS_SMS_ENABLED=false
# RENTALS_RENTAL_OFFICE_NAME=Trucker Heaven Rentals
# RENTALS_RENTAL_OFFICE_ADDRESS=8037 Eastgate Blvd, Mt. Juliet, TN 37122
# RENTALS_RENTAL_OFFICE_PHONE=615-470-5075
